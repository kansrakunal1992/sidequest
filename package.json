{
  "name": "sidequest",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:sql": "node scripts/check-sql.mjs",
    "verify": "pnpm test && pnpm check:sql"
  }
}
