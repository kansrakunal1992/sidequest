# ---- Supabase (Project settings > API) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. NEVER ship this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed on legacy projects that sign tokens with a shared secret (HS256). Newer projects use JWKS automatically.
SUPABASE_JWT_SECRET=

# ---- API service (Railway) ----
PORT=8080
API_PUBLIC_URL=
# Postgres connection string for the worker/API (Supabase > Database > Connection string)
DATABASE_URL=
# Set to "disable" only for a local non-SSL Postgres.
PGSSL=
# Only if the web admin console calls the API from a browser.
CORS_ORIGIN=

# ---- Push (Firebase Cloud Messaging) ----
FCM_SERVICE_ACCOUNT_JSON=

# ---- Optional provider adapters (feature-flagged; leave empty until configured) ----
FEATURE_VIDEO_CALLS=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
FEATURE_AGE_VERIFICATION=false
AGE_VERIFICATION_PROVIDER=
FEATURE_IMAGE_MODERATION=false
IMAGE_MODERATION_PROVIDER=

# ---- Mobile (public, safe to embed) ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=

# ---- Public pages (Google Play requires a privacy policy, terms and a web account-deletion page) ----
# The API serves /privacy, /terms and /delete-account ONLY when LEGAL_NAME and CONTACT_EMAIL are set.
LEGAL_NAME=
CONTACT_EMAIL=
# Child-safety contact Google Play asks for. Defaults to CONTACT_EMAIL.
CHILD_SAFETY_EMAIL=
APP_NAME=SideQuest
